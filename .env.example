# Never commit actual credentials. Export locally or use a real secret manager.
# Copy this file to .env and load securely in your own shell; ReachWeaver does not auto-load .env.
REACHWEAVER_BSKY_IDENTIFIER=
REACHWEAVER_BSKY_APP_PASSWORD=
REACHWEAVER_MASTODON_TOKEN=
REACHWEAVER_TELEGRAM_BOT_TOKEN=
# Even with approval, publishing requires this deliberate opt-in:
REACHWEAVER_ALLOW_LIVE=0
# dev | staging | prod. publish --live refuses unless this is prod; set prod on the production host only.
REACHWEAVER_ENV=dev
# Each account needs its own env_prefix; overlapping prefixes are refused when accounts load.
# Unattended systemd host: prefer LoadCredential= (credentials read from $CREDENTIALS_DIRECTORY);
# see docs/ACCOUNT-ONBOARDING.md.
# Optional override; persistent local filesystem required:
# REACHWEAVER_DB=state/reachweaver.sqlite
# REACHWEAVER_ACCOUNTS=config/accounts.json
